# Secrets and local configuration
.env
.env.*
!.env.example
.envrc
.direnv/
.secrets/
secrets/
credentials/

# Credential exports and private keys
# Google service-account downloads often use arbitrary project-name JSON filenames.
/*.json
# Explicit local Google service-account credential file
credentials*.json
service-account*.json
*service-account*.json
token*.json
*-credentials.json
*-key.json
*.pem
*.key
*.p12
*.pfx

# Python environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.tox/
.nox/
.cache/

# Coverage, test and profiling output
.coverage
.coverage.*
coverage.xml
htmlcov/
*.prof

# Packaging and build output
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# Runtime output and local data
*.log
*.pid
*.sqlite
*.sqlite3
*.db
tmp/
temp/

# Benchmark artifacts: keep the measured portfolio result, ignore other generated files
artifacts/*
!artifacts/.gitkeep
!artifacts/benchmark_results.json

# IDE and OS metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
